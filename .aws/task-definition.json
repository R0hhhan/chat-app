{
    "family": "server-task",
    "containerDefinitions": [
        {
            "name": "chat-app",
            "image": "590184058013.dkr.ecr.ap-south-1.amazonaws.com/chat-app:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "chat-app-port",
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PORT",
                    "value": "3000"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "1122334455667788qwertyui"
                },
                {
                    "name": "MONGODB_URI",
                    "value": "mongodb+srv://r0hhhan:Rohanpatil@cluster0.8higyjy.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/server-task",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "executionRoleArn": "arn:aws:iam::590184058013:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}